{
  "manifest_version": 3,
  "name": "IG Outreach Logger — PBPB",
  "version": "0.13.3",
  "description": "Фиксирует, кому отправили сообщение в Instagram Direct, и пишет строки в Google-таблицу.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "https://www.instagram.com/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*",
    "https://*.supabase.co/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "IG Outreach Logger",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/direct/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
